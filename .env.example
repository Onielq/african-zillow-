# MapLibre style URL. Liberty is the fallback when a configured style fails.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Server-only variables. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-side Valhalla base URL override for road-distance and travel-time estimates.
# When blank, the app uses the public demo at https://valhalla1.openstreetmap.de.
# The shared demo is rate-limited and intended for light testing; do not rely on it for production traffic.
# Set this to an approved hosted/self-managed Valhalla instance for production.
# Valhalla computes routes; it does not provide cadastral boundaries.
VALHALLA_BASE_URL=


# Resend contact form. Use a sender on a domain verified in Resend.
# The endpoint returns a safe setup error until all server-side values are configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
# Optional direct phone link; visitors can request a call-back without this value.
NEXT_PUBLIC_CONTACT_PHONE=

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

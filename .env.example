# MapLibre style URL. Liberty is the fallback when a configured style fails.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Server-only variables. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Valhalla is reserved for route tracing and travel-time analysis. It does not
# provide cadastral boundaries. Keep this empty until a provider is selected.
VALHALLA_BASE_URL=


# Optional integrations — placeholders only; these services are not wired into
# application features until an explicit implementation uses them.
# Neon / PostgreSQL uses DATABASE_URL above.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cloudflare R2 (S3-compatible object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
